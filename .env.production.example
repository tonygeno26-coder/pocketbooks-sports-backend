# Pocketbooks Sports Backend — Production Environment Variables
# Copy this file, fill in values, set in Railway → Variables.
# DO NOT commit your actual .env to git.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# System is broken without all five of these.

# Random 32+ character secret. Used to sign all auth tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase project URL. From: Supabase → Settings → API → Project URL
SUPABASE_URL=

# Supabase service role key (NOT the anon key). Full DB access.
# From: Supabase → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowed CORS origins. Must include your Vercel frontend URL.
# Example: https://pocketbooks-sports.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=

# API key from the-odds-api.com. Required for live odds feed.
ODDS_API_KEY=

# ── RECOMMENDED ──────────────────────────────────────────────────────────────
# System degrades without these. Set before going live.

# Comma-separated actorIds who get platform_admin role (cross-club access).
# Example: host_001,admin_brody
PLATFORM_ADMIN_ALLOWLIST=

# Crypto deposit wallet addresses. Falls back to hardcoded values if not set.
# ERC20 address for USDT/USDC/ETH deposits.
WALLET_ERC20=

# Bitcoin SegWit address for BTC deposits.
WALLET_BTC=

# Set to true to enable background job worker (odds refresh, grade run, etc.)
# Leave false if you want to trigger jobs manually via admin panel.
ENABLE_WORKER=true

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# Safe to leave unset. Sensible defaults apply.

# Enable real blockchain scanner for crypto tx verification.
# Leave false until scanner API is implemented.
BLOCKCHAIN_SCANNER_ENABLED=false

# Automatically credit diamonds when scanner confirms a crypto deposit.
# Leave false — requires explicit admin confirm by default.
AUTO_CREDIT_CONFIRMED_CRYPTO=false

# Dev auth bypass — allows host diamond fail-open in dev when host_diamond_balances row is missing.
# NEVER set to true in production — this bypasses monetization gating.
DEV_AUTH_BYPASS=false

# Semver for this deployment. Shown in /api/health.
APP_VERSION=1.0.0

# Git commit SHA. Set automatically in Railway deploy config, or set manually.
COMMIT_SHA=

# Enable verbose request logging. Off by default.
LOG_VERBOSE=false

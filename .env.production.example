# Pocketbooks Sports Backend — Production Environment Variables
# Copy this file, fill in values, set in Railway → Variables.
# DO NOT commit your actual .env to git.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# System is broken without all five of these.

# Random 32+ character secret. Used to sign all auth tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase project URL. From: Supabase → Settings → API → Project URL
SUPABASE_URL=

# Supabase service role key (NOT the anon key). Full DB access.
# From: Supabase → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowed CORS origins. Must include your Vercel frontend URL.
# pocketbookssports.com and www are always allowed in code; still list them here.
# Example: https://pocketbooks-sports.vercel.app,https://pocketbookssports.com,https://www.pocketbookssports.com
ALLOWED_ORIGINS=https://pocketbooks-sports.vercel.app,https://pocketbookssports.com,https://www.pocketbookssports.com

# Odds provider selection: the_odds_api (default) or owls_insight
ODDS_PROVIDER=the_odds_api

# API key from the-odds-api.com. Required when ODDS_PROVIDER=the_odds_api.
ODDS_API_KEY=

# Owls Insight odds provider. Required when ODDS_PROVIDER=owls_insight.
OWLS_INSIGHT_API_KEY=
OWLS_INSIGHT_BASE_URL=https://api.owlsinsight.com
OWLS_INSIGHT_BOOKS=pinnacle,fanduel,draftkings
OWLS_INSIGHT_ALTERNATES=false

# ── RECOMMENDED ──────────────────────────────────────────────────────────────
# System degrades without these. Set before going live.

# Comma-separated actorIds who get platform_admin role (cross-club access).
# Example: host_001,admin_brody
PLATFORM_ADMIN_ALLOWLIST=

# Crypto deposit wallet addresses. POCKETBOOKS_* is preferred; WALLET_* is fallback.
POCKETBOOKS_BTC_ADDRESS=
POCKETBOOKS_ETH_ADDRESS=
POCKETBOOKS_USDT_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
POCKETBOOKS_USDC_CONTRACT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
BTC_CONFIRMATIONS_REQUIRED=2
ETH_CONFIRMATIONS_REQUIRED=12
# Required for ETH/USDT/USDC scans. BTC uses blockchain.info (no key).
ETHERSCAN_API_KEY=
# Legacy fallbacks (used only if POCKETBOOKS_* unset)
WALLET_ERC20=
WALLET_BTC=

# Set to true to enable background job worker (odds refresh, grade run, etc.)
# Leave false if you want to trigger jobs manually via admin panel.
ENABLE_WORKER=true

# ── GRADING / SETTLEMENT (required for bet grading + balance updates) ────────
# In production these default to true if unset. Set explicitly to avoid ambiguity.
# GRADING_SETTLEMENT_ENABLED=true
# MANUAL_GRADE_SETTLEMENT_ENABLED=true
# WORKER_GRADE_SETTLEMENT_ENABLED=true
# GRADE_RUN_DRY_RUN_ENABLED=false

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# Safe to leave unset. Sensible defaults apply.

# Blockchain scanner is on unless set to false. BTC needs no key; ETH family needs ETHERSCAN_API_KEY.
BLOCKCHAIN_SCANNER_ENABLED=true

# Automatically credit PLAYER betting ledger when admin scan confirms a crypto deposit.
# Host diamond auto-credit is handled by the 2-minute scanner loop (HOST_DIAMOND_PURCHASE).
AUTO_CREDIT_CONFIRMED_CRYPTO=false

# Dev auth bypass — allows host diamond fail-open in dev when host_diamond_balances row is missing.
# NEVER set to true in production — this bypasses monetization gating.
DEV_AUTH_BYPASS=false

# Semver for this deployment. Shown in /api/health.
APP_VERSION=1.0.0

# Git commit SHA. Set automatically in Railway deploy config, or set manually.
COMMIT_SHA=

# Enable verbose request logging. Off by default.
LOG_VERBOSE=false
